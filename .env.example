# ============================================================
# AEAM — Environment template
# .env.example  —  copy this file to `.env` and fill in values.
#
# See deploy/env.yaml for the full manifest with descriptions and the
# production-source-of-truth for each variable.
# ============================================================

# --- Datastores (required) --------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
VECTOR_DB_URL=http://localhost:6333

# --- Posture (required) ------------------------------------------------
# development: E3 SecurityMiddleware is bypassed; JWT_PUBLIC_KEY optional.
# staging / production / test: JWT_PUBLIC_KEY MUST be set (fail-closed).
ENVIRONMENT=development
LLM_ENABLED=false

# --- E7: Autonomous operations ------------------------------------------
# Sole gate for the MonitorAgent polling loop — no environment backdoor.
# See docs/autonomous_operations.md for the full posture matrix.
ENABLE_MONITOR_AGENT=true
HEARTBEAT_STALE_SECONDS=120
BM25_STALE_SECONDS=3600

# --- Docker compose Postgres password (required for docker-compose) ---
POSTGRES_PASSWORD=CHANGE_ME

# --- E3: Identity & Access --------------------------------------------
# Only required outside `development`. Use a real RSA public key here or
# point JWT_PUBLIC_KEY_PATH at a PEM file.
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUDIT_LOG_FILE=/tmp/audit.log

# --- E4: Durable BlobStore backend ------------------------------------
# 'local' preserves today's LocalDiskBlobStore behavior. 's3' targets
# any S3-compatible endpoint. See deploy/env.yaml for the full list of
# BLOB_S3_* variables.
BLOB_STORAGE_BACKEND=local
BLOB_STORAGE_DIR=data/blobs
# BLOB_S3_BUCKET=
# BLOB_S3_REGION=
# BLOB_S3_ENDPOINT_URL=
# BLOB_S3_ACCESS_KEY_ID=
# BLOB_S3_SECRET_ACCESS_KEY=
# BLOB_S3_PREFIX=

# --- E4: Forecast model artifacts -------------------------------------
# Empty keeps the ForecastAgent's engine-owned default (models/forecasting).
FORECAST_MODEL_DIR=

# --- E4: Config persistence disclosure --------------------------------
# 'durable' locally (this compose posture persists writes to .env).
# Set to 'ephemeral' when deploying to compute where the writable layer
# does not survive recycle (Cloud Run).
CONFIG_PERSISTENCE_MODE=durable
CONFIG_PERSISTENCE_NOTE=

# --- E8: AI Governance --------------------------------------------------
# 'groq' is the only implemented provider — configuring anything else
# while LLM_ENABLED=true and USE_MOCK_LLM=false aborts startup with an
# explicit message. See docs/ai_governance.md.
LLM_PROVIDER=groq
LLM_API_KEY=
USE_MOCK_LLM=true
LLM_TIMEOUT_SECONDS=30
# LLM_COST_PER_1K_PROMPT_TOKENS_USD=0.0
# LLM_COST_PER_1K_COMPLETION_TOKENS_USD=0.0

# --- Optional integrations --------------------------------------------
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#aeam-alerts
JIRA_URL=
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=
GOOGLE_SHEETS_SA_CREDENTIALS=
SHEET_ID=
SHEET_RANGE=Sheet1!A2:C10
